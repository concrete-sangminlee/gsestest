# ─────────────────────────────────────────────────────────────
# GSES Notice Bot 설정 예시 — `cp env.example .env` 후 값을 채우세요.
# 비워 둔 항목은 기본값을 사용합니다.
# ─────────────────────────────────────────────────────────────

# [필수] Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# [선택] Webhook 대신 Bot Token 으로 보내기 (chat:write 권한, 봇을 채널에 초대해야 함)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=C0123456789

# [선택] 장애/복구 알림을 다른 채널로 받기 (기본값: 위와 같은 채널)
# SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# 감시할 게시판: notice(공지사항), seminars(세미나 및 강연), admissions(입학안내), news(새소식)
# GSES_BOARDS=notice,seminars,admissions,news

# 키워드 필터 (쉼표 구분, 대소문자 무시, 분류+제목 기준)
# - INCLUDE: 하나라도 포함된 글만 알림 / EXCLUDE: 포함된 글은 알림 제외
# - HIGHLIGHT: 포함된 글은 🔥 강조 + GSES_MENTION 멘션
# - MENTION: channel | here | U0123ABCD(사용자) | S0123ABCD(사용자 그룹)
# GSES_INCLUDE_KEYWORDS=
# GSES_EXCLUDE_KEYWORDS=셔틀버스
# GSES_HIGHLIGHT_KEYWORDS=장학,등록금,마감,논문
# GSES_MENTION=here

# 제목이 바뀐 글(예: '...(연장)') 알림 (기본값: true)
# GSES_NOTIFY_TITLE_CHANGES=true

# 게시판별 1회 최대 알림 수 — 초과분은 '외 N건'으로 요약 (기본값: 20)
# GSES_MAX_POSTS_PER_RUN=20

# 게시판별로 다른 채널에 보내기 (선택): SLACK_WEBHOOK_URL_<NOTICE|SEMINARS|ADMISSIONS|NEWS>
# SLACK_WEBHOOK_URL_SEMINARS=https://hooks.slack.com/services/...

# 마감 리마인더: 마감 며칠 전에 알릴지 (기본값: 1 → 전날 아침). 3,1,0 = D-3·D-1·당일, off = 끄기
# GSES_REMINDER_DAYS=1
# 리마인더를 보내기 시작할 시각 (KST, 기본값: 9)
# GSES_REMINDER_HOUR=9

# AI 요약 (선택): Anthropic API 키가 있으면 새 글을 Claude 로 2줄 요약합니다.
# ANTHROPIC_API_KEY=sk-ant-...
# GSES_AI_MODEL=claude-opus-5-5
# GSES_AI_SUMMARY=true

# 생존 신호 (선택): healthchecks.io 등의 Ping URL. 실패 시 <URL>/fail 을 호출합니다.
# GSES_HEARTBEAT_URL=https://hc-ping.com/your-uuid

# 연속 몇 번 수집에 실패하면 장애 알림을 보낼지 (기본값: 3 → 30분 주기 기준 약 1.5시간)
# GSES_FAILURE_ALERT_THRESHOLD=3

# state 파일 경로 (기본값: ./state.json)
# GSES_STATE_FILE=state.json

# state 가 없을 때(최초 실행)도 최신 글 1건 전송 (기본값: false — 기준점만 저장)
# SEND_ON_FIRST_RUN=false

# 고급: 페이지 스캔 수(3), 요청 간격 초(0.5), 상세 페이지 수집(true), 이미지 표시(true)
# GSES_MAX_PAGES=3
# GSES_REQUEST_DELAY=0.5
# GSES_FETCH_DETAILS=true
# GSES_SHOW_IMAGES=true
